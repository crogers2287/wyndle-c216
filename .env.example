# Wyndle identity
WYNDLE_NAME=Wyndle
WYNDLE_WAKE_WORD=wyndle
WYNDLE_WAKE_SECONDARY=hey wyndle

# Tapo C216 camera - use a dedicated local account, never reuse cloud password
TAPO_IP=192.168.1.123
TAPO_USERNAME=wyndle-local
TAPO_PASSWORD=change-me
TAPO_ONVIF_PORT=2020
TAPO_RTSP_PORT=554

# RTSP URLs - leave blank to auto-build from TAPO_* fields
RTSP_MAIN=
RTSP_SUB=

# go2rtc for speaker backchannel
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_STREAM_NAME=wyndle

# LLM / VLM - OpenAI compatible endpoints
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_MODEL=minicpm-v

# TTS / STT paths
PIPER_EXECUTABLE=/usr/local/bin/piper
PIPER_MODEL=/path/to/en_US-ryan-low.onnx
WHISPER_PYTHON=/usr/bin/python3
WHISPER_MODEL=/path/to/faster-whisper-model

# Runtime
CONVERSATION_TIMEOUT_SECONDS=15
PERSISTENT_MEMORY_ENABLED=false
PROACTIVE_SPEECH_ENABLED=false
